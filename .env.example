# Скопируй этот файл в .env и заполни значения
# На Railway эти переменные задаются в настройках сервиса (Variables)

# Токен бота от @BotFather в Telegram (ОБЯЗАТЕЛЬНО)
TG_BOT_TOKEN=

# Ссылка для записи на консультацию (показывается при низкой оценке)
CONSULTANT_LINK=https://t.me/elena_vasilenko

# Пароль для входа в админ-панель
ADMIN_SECRET=elena2026

# Твой Telegram user_id (для прав администратора)
# Узнать можно у @userinfobot в Telegram
ADMIN_IDS=

# Через сколько дней отправлять сводку (по умолчанию 3)
SUMMARY_DAYS=3

# При каком рейтинге показывать CTA консультации (по умолчанию 5 и ниже)
LOW_RATING_THRESHOLD=5

# Путь к базе данных (менять не нужно, Railway сам смонтирует /data)
DB_PATH=/data/achievements.db
